{
	"name": "meal-planner",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "aubx convex dev --start \"vite dev --open\"",
		"dev:host": "aubx convex dev --start \"vite dev --host --open\"",
		"dev:app": "vite dev --open",
		"dev:convex": "aubx convex dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "biome check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@sveltejs/vite-plugin-svelte-inspector": "^5.0.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@convex-dev/auth": "^0.0.95",
		"@lucide/svelte": "^1.46.0",
		"@mmailaender/convex-auth-svelte": "^0.1.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"convex": "^1.45.0",
		"convex-svelte": "^0.14.0",
		"jose": "^6.2.12",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	}
}
